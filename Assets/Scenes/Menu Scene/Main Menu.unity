  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Hi! \nToday you'll be playing as Jimmy.\n\nJimmy is just a regular guy
    who got hit with hard times and was laid off. \nHe is now stuck on his couch
    while unemployed.\nHowever, one faithful day, something completely unexpected
    happened!\n\nJimmy was transported back in time, for reasons we won't explain
    (our writers could not manage to come up with a reason that could satisfy you,
    the player).\n\n\nJimmy now finds himself in a fantastical realm filled with
    monsters, magic, and mischief.\nIn this realm of high fantasy and wonder, a small
    village lie.\nThis village is filled with idiots, incapable of taking care of
    themselves.\n\n\nThus, as Jimmy, you now find yourself bestowed with the duty
    of helping these poor suckers. \nProtect them, care for them, and grow their
    village to prosperity!\n\nGood luck wanker, and godspeed!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: e73a58f6e2794ae7b1b7e50b7fb811b0, type: 2}
