.header {
    font-size: 40px;
    color: rgb(255, 255, 255);
    justify-content: flex-start;
    -unity-text-align: upper-center;
    -unity-font: url('project://database/Assets/TextMesh%20Pro/Fonts/InterBold.otf?fileID=12800000&guid=d56c9b009c32206468f7ca7f5b21cc2a&type=3#InterBold');
}

.button {
    font-size: 20px;
    width: 220px;
    height: 60px;
    -unity-text-align: middle-center;
    align-self: center;
    border-top-left-radius: 24px;
    border-bottom-left-radius: 24px;
    border-top-right-radius: 24px;
    border-bottom-right-radius: 24px;
    background-image: url('project://database/Assets/Scenes/Menu%20Scene/%E2%80%94Pngtree%E2%80%94cartoon%20fantasy%20summer%20travel%20promotion_1036116.jpg?fileID=21300000&guid=ce51b548becb7824caac2b4b5bba6132&type=3#—Pngtree—cartoon fantasy summer travel promotion_1036116');
    margin-top: 50px;
    color: rgb(255, 255, 255);
    white-space: normal;
    text-overflow: clip;
    -unity-font: initial;
    justify-content: flex-start;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    -unity-background-scale-mode: stretch-to-fill;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    -unity-slice-scale: 1px;
    opacity: 1;
    visibility: visible;
    overflow: visible;
}
