.inventory-container 
{
    border-style: solid;
    border-color: blue;
    border-width: 1px;
    flex-grow: 1;
    flex-shrink: 1;
}

.inventory-row 
{
    flex-direction: row;
    align-self: flex-start;
    min-height: 50px;
    border-style: solid;
    border-color: red;
    border-width: 1px;
    flex-grow: 0;
    flex-shrink: 1;
}

.inventory-slot 
{
    width: 100px;
    height: 100px;
    background-color: rgb(255, 255, 255);
    border-width: 2px;
    border-color: rgb(0, 0, 0);
    border-style: solid;
    margin: 5px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    flex-basis: 0;
}

.inventory-slot2 
{
    width: 100px;
    height: 100px;
    margin: 5px;
    border-style: solid;
    border-color: green;
    border-width: 1px;
}

.item-container
{
    width:100%;
    height:100%;
    background-color: rgba(255,255,255, 0.5);
    border-radius:3px;
}

.Item-Drag
{
    display: none;
    position: absolute;
    width: 100px;
    height: 100px;
    border-style: solid;
    border-color: orange;
    border-width: 1px;
    border-radius: 5px;
    
}
.item-icon 
{
    width: 80px;
    height: 80px;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    margin: 0;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.92);
}

.item-name 
{
    font-size: 14px;
    color: rgb(0, 0, 0);
    -unity-text-align: middle-center;
    margin: 0;
    padding-top: 5px;
}

.item-quantity 
{
    position: absolute;
    bottom:0px;
    right:0px;
    font-size: 12px;
    color: rgb(85, 85, 85);
    -unity-text-align: middle-center;
    margin: 0;
    padding-top: 2px;
}

.tooltip 
{
    position: absolute;
    padding: 10px;
    background-color: rgba(0, 0, 0, 0.8);
    color: white;
    border-radius: 5px;
    display: none;
    flex: 1000;
}

.tooltip-text 
{
    font-size: 14px;
    margin: 5px;
    color: rgb(255, 255, 255);
}

.inventory-grid 
{
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-items: flex-start;
    padding: 10px;
}
